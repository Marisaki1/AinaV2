{
  "name": "worldbuilder-local",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "build": "npm run check && vite build",
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/check-dropdowns.mjs && tsc --noEmit",
    "format": "prettier --write frontend vite.config.ts tsconfig.json package.json scripts/**/*.js scripts/**/*.mjs",
    "format:check": "prettier --check frontend vite.config.ts tsconfig.json package.json scripts/**/*.js scripts/**/*.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dompurify": "^3.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
