DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_application_id_here
# Use guild scope during setup. Copy your server ID with Discord Developer Mode.
COMMAND_SCOPE=guild
# Optional additional server copies, including when primary scope is global.
COMMAND_GUILD_IDS=
GUILD_ID=your_server_id_here
# Verify/synchronize on startup; unchanged commands are not rewritten.
# Set false to skip startup sync; commands:sync still publishes explicitly.
REGISTER_COMMANDS=true
# Optional override for Aina's existing owner/personality setting.
OWNER_ID=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
ALARM_TIMEZONE=Asia/Manila
TTS_VOICE=en-US-JennyNeural
# Speech uses its own Groq key, independent of GROQ_API_KEY (AI chat).
TTS_PROVIDER=groq
GROQ_TTS_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel, troy
GROQ_TTS_VOICE=autumn
# Additional TTS providers. Set keys only for services you want to use.
# Local engines: no cloud keys. See docs/tts.md for install/start commands.
WINDOWS_TTS_VOICE=
PIPER_TTS_URL=http://127.0.0.1:5000
PIPER_TTS_VOICE=en_US-lessac-medium
KOKORO_TTS_URL=http://127.0.0.1:8880/v1
KOKORO_TTS_VOICE=af_heart
ESPEAK_TTS_PATH=espeak-ng
ESPEAK_TTS_VOICE=en-us
LOCAL_TTS_URL=http://127.0.0.1:8080/v1
LOCAL_TTS_MODEL=tts
LOCAL_TTS_VOICE=default
LOCAL_TTS_VOICES=default
LOCAL_TTS_API_KEY=
# Free hosted plans have quotas; use the provider's free plan when signing up.
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Charon
ELEVENLABS_TTS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_VOICE=
CARTESIA_TTS_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_TTS_VERSION=2026-08-14
CARTESIA_TTS_VOICE=
AZURE_TTS_API_KEY=
AZURE_TTS_REGION=
AZURE_TTS_VOICE=en-US-GuyNeural
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Standard-B
IBM_TTS_API_KEY=
IBM_TTS_URL=
IBM_TTS_VOICE=en-US_MichaelV3Voice
CLOUDFLARE_TTS_API_TOKEN=
CLOUDFLARE_TTS_ACCOUNT_ID=
CLOUDFLARE_TTS_VOICE=aura-2-en/apollo
# Optional: defaults to the Discord application owner. Required to override a team owner.
CRITTER_OWNER_ID=
# Local editor port (open http://127.0.0.1:4317 on the bot computer).
CRITTER_PORT=4317
# Legacy headless test browser selection. Real CritterDB editing uses the existing-tab extension.
CRITTER_BROWSER_CHANNEL=brave
# Optional full browser executable path if it is installed in a custom location.
# CRITTER_BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Commands post through Aina's existing official bot connection (DISCORD_TOKEN).
# No separate user-session token, account login, or panel password is used.

# WorldBuilder is started and stopped by Aina; change only if port 8777 conflicts.
WORLDBUILDER_PORT=8777
