DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_application_id_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Optional: defaults to the Discord application owner. Required to override a team owner.
CRITTER_OWNER_ID=
# Local editor port (open http://127.0.0.1:4317 on the bot computer).
CRITTER_PORT=4317
# Legacy headless test browser selection. Real CritterDB editing uses the existing-tab extension.
CRITTER_BROWSER_CHANNEL=brave
# Optional full browser executable path if it is installed in a custom location.
# CRITTER_BROWSER_EXECUTABLE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Commands post through Aina's existing official bot connection (DISCORD_TOKEN).
# No separate user-session token, account login, or panel password is used.
