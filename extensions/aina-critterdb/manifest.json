{
  "manifest_version": 3,
  "name": "Aina · CritterDB connection",
  "version": "1.0.1",
  "description": "Connect Aina's local editor to a CritterDB tab you already opened. Never opens a browser or reads your login credentials.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://critterdb.com/*", "https://www.critterdb.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/*"], "js": ["relay.js"], "run_at": "document_start" }],
  "action": { "default_popup": "popup.html", "default_title": "Aina CritterDB connection" }
}
