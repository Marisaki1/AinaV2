{
  "name": "aina",
  "version": "2.1.0",
  "description": "Aina - Your AI daughter Discord bot",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node index.js",
    "critter": "node src/critter/server.js",
    "test": "node --test test/*.test.js",
    "test:core": "node scripts/test-core.js",
    "doctor": "node scripts/doctor.js",
    "commands:sync": "node scripts/sync-commands.js",
    "tts:setup": "node scripts/tts-local.js setup",
    "tts:serve": "node scripts/tts-local.js serve",
    "tts:voices": "node scripts/tts-tools.js voices",
    "tts:check": "node scripts/tts-tools.js check",
    "test:tts:local": "node scripts/check-tts-local.js",
    "docs:commands": "node scripts/generate-command-docs.js",
    "docs:check": "node scripts/generate-command-docs.js --check",
    "test:critter:browser": "node scripts/check-critter-browser.js",
    "test:critter:desk": "node scripts/check-critter-desk.js",
    "test:critter:remote": "node scripts/check-critter-remote.js",
    "dev": "nodemon index.js",
    "test:critter:traits": "node scripts/check-critter-traits.js",
    "test:critter:authoring": "node scripts/check-critter-authoring.js",
    "test:critter:direct": "node scripts/check-critter-direct.js",
    "test:critter:manual": "node scripts/check-critter-selects.js",
    "configure:sender": "node scripts/configure-discord-sender.js",
    "test:critter:bot-panel": "node scripts/check-critter-bot-panel.js",
    "test:critter:workshop": "node scripts/check-critter-workshop.js",
    "test:critter:ability-tools": "node scripts/check-critter-ability-tools.js",
    "test:critter:critical-party": "node scripts/check-critter-critical-party.js",
    "test:critter:spellcasting": "node scripts/check-critter-spellcasting.js",
    "test:avrae:expressions": "node scripts/check-avrae-compat.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.3.0",
    "groq-sdk": "^0.9.1",
    "moment-timezone": "^0.5.45",
    "msedge-tts": "^2.1.1",
    "node-cron": "^3.0.3",
    "opusscript": "^0.0.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "nodemon": "^3.1.0"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.9.0"
  }
}
